# Copy this file to .env.local and change the values you need.

# Where tasks are saved:
#   local    -> profiles and tasks in the browser (default, no setup needed)
#   supabase -> real login with Supabase Auth and tasks in a Supabase database
NEXT_PUBLIC_TASKS_STORAGE=local

# Needed only with NEXT_PUBLIC_TASKS_STORAGE=supabase
# Supabase dashboard -> Settings -> API Keys (or the "Connect" button)
# Use the publishable key (sb_publishable_...), never the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
